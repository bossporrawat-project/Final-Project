<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Omni Tracker (Native)"
        android:textSize="24sp"
        android:textColor="#06B6D4"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="16dp"
        android:layout_marginBottom="24dp">
        
        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 GPS: Waiting..."
            android:textColor="#F59E0B"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvDbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗄️ Database: Idle (Press Start)"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device Name (ชื่ออุปกรณ์)"
        android:textColor="#06B6D4"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="เช่น Pixel_Pro_01"
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:background="#1E293B"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:baselineAligned="false"
        android:layout_marginBottom="24dp">
        
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPS Interval (อ่านพิกัด)"
                android:textColor="#06B6D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etGpsInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="วินาที"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:padding="16dp"
                android:background="#1E293B"/>
        </LinearLayout>
            
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sync Interval (ส่งขึ้นเว็บ)"
                android:textColor="#06B6D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etSyncInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="วินาที"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:padding="16dp"
                android:background="#1E293B"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnStartTracking"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="START TRACKING"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#10B981"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnStopTracking"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="STOP TRACKING"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#EF4444"
        android:layout_marginBottom="16dp"/>
</LinearLayout>

